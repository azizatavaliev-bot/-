# --- обязательно ---
ANTHROPIC_API_KEY=            # советник и диалог в Telegram
OWNER_LOGIN=owner             # создаётся при первом запуске
OWNER_PASSWORD=               # длинный пароль владельца (если пусто — сгенерируется и выведется в лог)
APP_SECRET=                   # ключ шифрования токенов Facebook: длинная случайная строка. СОХРАНИ — без него токены не расшифровать

# --- Telegram ---
TELEGRAM_BOT_TOKEN=           # от @BotFather. Один общий бот на всю команду

# --- Facebook-приложение платформы (необязательно, но желательно) ---
# Даёт: проверку срока жизни токенов («истекает через N дней») и форму обмена 60-дневного токена
META_APP_ID=
META_APP_SECRET=

# --- прочее ---
PORT=3000
DATA_DIR=./data
# TZ_DEFAULT=Asia/Bishkek
# CLAUDE_MODEL=claude-sonnet-5-5
