# Порт. На Railway и большинстве хостингов подставляется автоматически.
PORT=3000

# Ключ подписи токена с дедлайном. Задайте один раз длинной случайной строкой
# и больше не меняйте: смена ключа обнуляет таймеры у всех посетителей.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Ключ доступа к списку заявок: /admin.html?key=ВАШ_КЛЮЧ
ADMIN_KEY=

# Куда складывать заявки на хостинге с постоянным диском.
# На Railway создайте том и смонтируйте его в /data, тогда значение — /data
LEADS_DIR=

# Дублирование заявок в Telegram (необязательно, но удобно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
