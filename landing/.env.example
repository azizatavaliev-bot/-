# Порт HTTP-сервера
PORT=3000

# Ключ подписи cookie с дедлайном. Задайте один раз длинной случайной строкой
# и больше не меняйте: смена ключа обнуляет таймеры у всех посетителей.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Ключ доступа к списку заявок: /admin.html?key=ВАШ_КЛЮЧ
ADMIN_KEY=change-me

# Куда присылать заявки в Telegram (необязательно, но на serverless-хостинге
# это основной способ их получать). Токен берётся у @BotFather,
# chat id — у @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
