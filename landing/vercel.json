{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/session", "dest": "/api/session.js" },
    { "src": "/api/submit", "dest": "/api/submit.js" },
    { "src": "/api/leads", "dest": "/api/leads.js" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
