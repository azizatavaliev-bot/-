# --- обязательно ---
ANTHROPIC_API_KEY=            # https://console.anthropic.com/
ADMIN_PASSWORD=               # пароль от панели (длинный!). Без него пароль генерируется при каждом запуске

# --- Meta Ads (для статистики и управления рекламой) ---
# Токен System User из Business Manager со сроком действия "Никогда" (см. README)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=           # необязательно: можно указать в панели → Настройки
# META_API_VERSION=v23.0

# --- необязательно ---
PORT=3000
DATA_DIR=./data               # тут лежат БД и сессия WhatsApp — этот каталог обязан переживать перезапуски
# CLAUDE_MODEL=claude-sonnet-5-5
# TZ_DEFAULT=Asia/Bishkek
